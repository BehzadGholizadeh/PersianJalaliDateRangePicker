diff --git a/style/visual.less b/style/visual.less
index 4dc6bdd..f191c66 100644
--- a/style/visual.less
+++ b/style/visual.less
@@ -320,3 +320,53 @@
     .pjdp-btn--primary { background: var(--pjdp-accent); color: var(--pjdp-bg); }
     .pjdp-btn, .pjdp-nav-btn { border-color: var(--pjdp-fg); }
 }
+
+/* ---------- collapsed: range summary only ---------- */
+.pjdp--collapsed {
+    background: transparent;
+    border: 0;
+    padding: 0;
+    overflow: hidden;
+}
+.pjdp-summary {
+    display: flex;
+    align-items: center;
+    gap: .55em;
+    width: 100%;
+    height: var(--pjdp-summary-h, 36px);
+    flex: 0 0 auto;
+    padding: 0 .9em;
+    background: var(--pjdp-bg, #fff);
+    border: var(--pjdp-border, 1px solid @line);
+    border-radius: var(--pjdp-radius, 8px);
+    font-size: var(--pjdp-summary-font, 14px);
+    font-weight: 700;
+    text-align: start;
+    color: @ink;
+
+    &:hover:not(:disabled) {
+        border-color: var(--pjdp-accent, #0E7C7B);
+        box-shadow: inset 0 0 0 1px var(--pjdp-accent, #0E7C7B);
+    }
+    &:active:not(:disabled) { background: var(--pjdp-accent-faint, rgba(14, 124, 123, .07)); }
+}
+.pjdp-summary-icon {
+    flex: 0 0 auto;
+    width: 1.15em;
+    height: 1.15em;
+    color: var(--pjdp-accent, #0E7C7B);
+}
+.pjdp-summary-text {
+    flex: 1 1 auto;
+    min-width: 0;
+    white-space: pre;            /* keep the double spaces around the arrow */
+    overflow: hidden;
+    text-overflow: ellipsis;
+    font-variant-numeric: tabular-nums;
+}
+.pjdp-summary--empty .pjdp-summary-text {
+    font-weight: 400;
+    color: @muted;
+}
+.pjdp--hc .pjdp-summary { color: var(--pjdp-fg); border: 1px solid var(--pjdp-fg); }
+.pjdp--hc .pjdp-summary--empty .pjdp-summary-text { color: var(--pjdp-fg); }
