diff --git a/style/visual.less b/style/visual.less
index f191c66..d2d96ba 100644
--- a/style/visual.less
+++ b/style/visual.less
@@ -370,3 +370,67 @@
 }
 .pjdp--hc .pjdp-summary { color: var(--pjdp-fg); border: 1px solid var(--pjdp-fg); }
 .pjdp--hc .pjdp-summary--empty .pjdp-summary-text { color: var(--pjdp-fg); }
+
+/* ---------- drill-down / drill-up (Day -> Month -> Year) ---------- */
+/* Month/year in the header look exactly like the previous plain label until hovered/focused. */
+.pjdp-drill {
+    display: inline;
+    padding: 0;
+    border: 0;
+    background: transparent;
+    font: inherit;
+    color: inherit;
+    border-radius: 3px;
+    text-decoration: underline;
+    text-decoration-color: transparent;
+    text-underline-offset: 4px;
+    text-decoration-thickness: 1px;
+    &:hover:not(:disabled) {
+        color: var(--pjdp-accent, #0E7C7B);
+        text-decoration-color: currentColor;
+        text-decoration-style: dotted;
+    }
+}
+.pjdp-year-range { font-variant-numeric: tabular-nums; }
+
+/* Month/Year View replace the weekday row + 6 day rows with one 3x4 grid of the same height. */
+.pjdp--view-month,
+.pjdp--view-year {
+    .pjdp-weekdays,
+    .pjdp-grid { display: none; }
+}
+.pjdp-pick {
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    grid-template-rows: repeat(4, minmax(0, 1fr));
+    gap: 4px;
+    height: calc(var(--pjdp-wd-h, 20px) + 6 * var(--pjdp-cell-h, 34px) + 5 * 2px + var(--pjdp-gap, 6px));
+}
+.pjdp-pick-cell {
+    position: relative;
+    min-width: 0;
+    padding: 0 2px;
+    border: 1px solid transparent;
+    border-radius: 6px;
+    background: transparent;
+    font-size: var(--pjdp-cal-font, 13px);
+    font-variant-numeric: tabular-nums;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+    &:hover:not(:disabled) { border-color: var(--pjdp-accent, #0E7C7B); }
+    &:disabled { visibility: hidden; }
+}
+.pjdp-pick-cell--in { background: var(--pjdp-accent-soft, rgba(14, 124, 123, .14)); }
+.pjdp-pick-cell--today { font-weight: 700; box-shadow: inset 0 -2px 0 var(--pjdp-accent, #0E7C7B); }
+.pjdp-pick-cell--current {
+    background: var(--pjdp-accent, #0E7C7B);
+    color: #fff;
+    font-weight: 700;
+}
+.pjdp-pick-cell--current.pjdp-pick-cell--today { box-shadow: inset 0 -2px 0 #fff; }
+.pjdp--hc {
+    .pjdp-pick-cell { border-color: var(--pjdp-fg); color: var(--pjdp-fg); }
+    .pjdp-pick-cell--in { border-style: dashed; background: transparent; }
+    .pjdp-pick-cell--current { background: var(--pjdp-accent); color: var(--pjdp-bg); }
+}
